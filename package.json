{
  "name": "dsh-development-harness-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "change-scope": "tsx scripts/change-scope.ts",
    "hooks:install": "lefthook install",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsx scripts/run-oxlint.ts scripts vitest.config.ts",
    "verify-agent-notes": "pnpm run verify-agent-note-classification && pnpm run verify-agent-note-format",
    "verify-agent-note-classification": "tsx scripts/verify-agent-note-classification.ts",
    "verify-agent-note-format": "tsx scripts/verify-agent-note-format.ts",
    "verify-corpus-classification": "tsx scripts/verify-corpus-classification.ts",
    "verify-md-links": "tsx scripts/verify-md-links.ts",
    "rewrite-removed-source-links": "tsx scripts/rewrite-removed-source-links.ts",
    "verify-md-wrap": "tsx scripts/verify-md-wrap.ts",
    "verify-mermaid": "tsx scripts/verify-mermaid.ts",
    "verify-public-repository-links": "tsx scripts/verify-public-repository-links.ts",
    "verify-skill-invocation-metadata": "tsx scripts/verify-skill-invocation-metadata.ts",
    "verify-translation-prompt": "tsx scripts/verify-translation-prompt.ts",
    "verify-doc-budgets": "tsx scripts/verify-doc-budgets.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run verify-agent-notes && pnpm run verify-corpus-classification && pnpm run verify-md-links && pnpm run verify-md-wrap && pnpm run verify-mermaid && pnpm run verify-public-repository-links && pnpm run verify-skill-invocation-metadata && pnpm run verify-translation-prompt && pnpm run verify-doc-budgets"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "js-yaml": "^4.2.0",
    "jsdom": "29.1.1",
    "lefthook": "^2.1.9",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "11.16.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
